{
  "manifest_version": 3,
  "name": "Novablock",
  "version": "1.1.0",
  "description": "Bloque les formats courts sans faire perdre la page, le défilement ou l'application en cours.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://fb.watch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://fb.watch/*"
      ],
      "js": [
        "url-rules.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Novablock"
  }
}
